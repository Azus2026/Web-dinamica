---
import "../styles/global.css";
import { hotelData } from "../data/hotel";
---

<!doctype html>
<html lang="es" class="bg-[#0F0E0C] text-[#F4EFE6]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Política de Cookies — {hotelData.name}</title>
  </head>
  <body class="min-h-screen bg-[#0F0E0C] text-[#F4EFE6] p-6 sm:p-16 font-sans antialiased">
    <main class="max-w-3xl mx-auto space-y-6">
      <a href="/" class="text-xs uppercase tracking-widest text-[#C87D4B] hover:underline">← Volver a {hotelData.name}</a>
      <h1 class="font-serif text-3xl sm:text-4xl text-[#F4EFE6]">Política de Cookies</h1>
      <p class="text-sm text-[#B8B0A2] leading-relaxed">
        Este sitio utiliza únicamente almacenamiento técnico esencial para mantener el estado de la cotización de estancia y la conexión temporal con proveedores EIP-6963 (MetaMask, Rabby) durante la sesión activa del usuario. No utilizamos cookies de rastreo publicitario de terceros.
      </p>
    </main>
  </body>
</html>
