---
import "../styles/global.css";
import { hotelData } from "../data/hotel";
import { HOTEL_TREASURY_EVM } from "../scripts/web3-checkout";
---

<!doctype html>
<html lang="es" class="bg-[#0F0E0C] text-[#F4EFE6]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aviso Legal — {hotelData.name}</title>
  </head>
  <body class="min-h-screen bg-[#0F0E0C] text-[#F4EFE6] p-6 sm:p-16 font-sans antialiased">
    <main class="max-w-3xl mx-auto space-y-6">
      <a href="/" class="text-xs uppercase tracking-widest text-[#C87D4B] hover:underline">← Volver a {hotelData.name}</a>
      <h1 class="font-serif text-3xl sm:text-4xl text-[#F4EFE6]">Aviso Legal e Información Corporativa</h1>
      <p class="text-sm text-[#B8B0A2] leading-relaxed">
        Este portal opera como canal oficial de reservas directas de <strong>{hotelData.name}</strong> ({hotelData.tagline}), integrado en tiempo real con el sistema de gestión hotelera <strong>Sumac Gestión PMS</strong>.
      </p>
      <div class="p-4 rounded-2xl bg-[#161411] border border-[#F4EFE6]/15 space-y-2 text-xs text-[#B8B0A2]">
        <p><strong class="text-[#F4EFE6]">Dirección Física:</strong> {hotelData.contact.address}</p>
        <p><strong class="text-[#F4EFE6]">Contacto Oficial:</strong> {hotelData.contact.email} · {hotelData.contact.phone}</p>
        <p><strong class="text-[#F4EFE6]">Red Blockchain Soportada:</strong> Arbitrum One (Chain ID 42161)</p>
        <p><strong class="text-[#F4EFE6]">Tesorería Oficial Verificada:</strong> <span class="font-mono text-[#C87D4B]">{HOTEL_TREASURY_EVM}</span></p>
      </div>
    </main>
  </body>
</html>
